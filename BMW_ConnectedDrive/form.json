{
    "elements": [
        {
            "type": "ValidationTextBox",
            "name": "client_id",
            "caption": "BMW CarData Client-ID",
            "validate": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        {
            "type": "NumberSpinner",
            "name": "update_interval",
            "caption": "Aktualisierungsintervall (Sekunden)",
            "minimum": 60,
            "suffix": "s"
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "1. Anmeldung starten (Browser-Code generieren)",
            "onClick": "BMWCD_StartDeviceAuth($id);"
        },
        {
            "type": "Button",
            "caption": "2. Anmeldung prüfen (nach Browser-Freigabe klicken)",
            "onClick": "BMWCD_CheckDeviceAuth($id);"
        },
        {
            "type": "Button",
            "caption": "Fahrzeugdaten jetzt abrufen",
            "onClick": "BMWCD_FetchVehicleData($id);"
        },
        {
            "type": "Button",
            "caption": "Auth zurücksetzen",
            "onClick": "BMWCD_ResetAuth($id);"
        }
    ],
    "status": [
        {
            "code": 101,
            "icon": "inactive",
            "caption": "Instanz wird erstellt"
        },
        {
            "code": 102,
            "icon": "active",
            "caption": "Verbunden"
        },
        {
            "code": 200,
            "icon": "error",
            "caption": "Fehler – Details im IPS-Log"
        },
        {
            "code": 201,
            "icon": "inactive",
            "caption": "Nicht konfiguriert – Client-ID eintragen"
        },
        {
            "code": 202,
            "icon": "inactive",
            "caption": "Anmeldung erforderlich – Schritt 1 klicken"
        },
        {
            "code": 203,
            "icon": "inactive",
            "caption": "Warte auf Browser-Anmeldung – Schritt 2 nach Code-Eingabe klicken"
        }
    ]
}
