{
    "elements": [
        {
            "type": "ValidationTextBox",
            "name": "client_id",
            "caption": "BMW CarData Client-ID (UUID)",
            "validate": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        {
            "type": "Label",
            "caption": "Client-ID: bmw-cardata.bmwgroup.com/customer/public  |  Fahrzeugfreigabe: bmw-cardata.bmwgroup.com -> MyBMW -> Fahrzeug -> CarData"
        },
        {
            "type": "NumberSpinner",
            "name": "update_interval",
            "caption": "Aktualisierungsintervall (Sekunden, min. 300 wegen BMW Rate-Limit)",
            "minimum": 300,
            "suffix": "s"
        },
        {
            "type": "ExpansionPanel",
            "caption": "Allgemein (alle Fahrzeuge)",
            "expanded": true,
            "items": [
                {
                    "type": "RowLayout",
                    "items": [
                        {"type": "CheckBox", "name": "key_mileage",   "caption": "Kilometerstand"},
                        {"type": "CheckBox", "name": "key_locked",    "caption": "Verriegelt"},
                        {"type": "CheckBox", "name": "key_door_all",  "caption": "Tuer-Gesamtstatus"}
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {"type": "CheckBox", "name": "key_lat",       "caption": "GPS Breitengrad"},
                        {"type": "CheckBox", "name": "key_lon",       "caption": "GPS Laengengrad"},
                        {"type": "CheckBox", "name": "key_heading",   "caption": "Fahrtrichtung"}
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {"type": "CheckBox", "name": "key_batt12v",   "caption": "12V-Batterie (%)"},
                        {"type": "CheckBox", "name": "key_nav_range", "caption": "Reichweite (Navi)"}
                    ]
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Verbrenner / Hybrid (ICE, PHEV)",
            "expanded": true,
            "items": [
                {
                    "type": "RowLayout",
                    "items": [
                        {"type": "CheckBox", "name": "key_fuel_pct",  "caption": "Kraftstoff (%)"},
                        {"type": "CheckBox", "name": "key_fuel_l",    "caption": "Kraftstoff (L)"},
                        {"type": "CheckBox", "name": "key_range_tot", "caption": "Gesamtreichweite"}
                    ]
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Elektro / Plug-in Hybrid (BEV, PHEV)",
            "expanded": true,
            "items": [
                {
                    "type": "RowLayout",
                    "items": [
                        {"type": "CheckBox", "name": "key_ev_level",   "caption": "Ladestand (%)"},
                        {"type": "CheckBox", "name": "key_ev_status",  "caption": "Ladestatus"},
                        {"type": "CheckBox", "name": "key_ev_range",   "caption": "EV-Reichweite"}
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {"type": "CheckBox", "name": "key_ev_time",    "caption": "Zeit bis Vollladung"},
                        {"type": "CheckBox", "name": "key_ev_plugged", "caption": "Ladekabel"}
                    ]
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Einzelne Tueren, Kofferraum & Fenster",
            "expanded": false,
            "items": [
                {
                    "type": "RowLayout",
                    "items": [
                        {"type": "CheckBox", "name": "key_door_fl", "caption": "Tuer vorne links"},
                        {"type": "CheckBox", "name": "key_door_fr", "caption": "Tuer vorne rechts"},
                        {"type": "CheckBox", "name": "key_door_rl", "caption": "Tuer hinten links"},
                        {"type": "CheckBox", "name": "key_door_rr", "caption": "Tuer hinten rechts"},
                        {"type": "CheckBox", "name": "key_trunk",   "caption": "Kofferraum"}
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {"type": "CheckBox", "name": "key_win_fl", "caption": "Fenster vorne links"},
                        {"type": "CheckBox", "name": "key_win_fr", "caption": "Fenster vorne rechts"},
                        {"type": "CheckBox", "name": "key_win_rl", "caption": "Fenster hinten links"},
                        {"type": "CheckBox", "name": "key_win_rr", "caption": "Fenster hinten rechts"}
                    ]
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "Label",
            "caption": "── Erstanmeldung (einmalig) ─────────────────────────────────────────"
        },
        {
            "type": "Label",
            "caption": "Schritt 1: Code generieren. Danach dieses Fenster schliessen und wieder oeffnen – Code und URL erscheinen dann oben."
        },
        {
            "type": "Button",
            "caption": "1. Anmeldung starten",
            "onClick": "BMWCD_StartDeviceAuth($id);"
        },
        {
            "type": "Label",
            "caption": "Schritt 2: Browser oeffnen (URL oben), Code eingeben, BMW-Account bestaetigen, dann hier klicken:"
        },
        {
            "type": "Button",
            "caption": "2. Anmeldung pruefen (nach Browser-Bestaetigung)",
            "onClick": "BMWCD_CheckDeviceAuth($id);"
        },
        {
            "type": "Label",
            "caption": "── Manuell ──────────────────────────────────────────────────────────"
        },
        {
            "type": "Button",
            "caption": "Fahrzeugdaten jetzt abrufen",
            "onClick": "BMWCD_FetchVehicleData($id);"
        },
        {
            "type": "Button",
            "caption": "Auth zuruecksetzen (erzwingt erneuten Device-Code-Login)",
            "onClick": "BMWCD_ResetAuth($id);"
        }
    ],
    "status": [
        {"code": 101, "icon": "inactive", "caption": "Instanz wird erstellt"},
        {"code": 102, "icon": "active",   "caption": "Verbunden"},
        {"code": 200, "icon": "error",    "caption": "Fehler - Details im IPS-Log"},
        {"code": 201, "icon": "inactive", "caption": "Nicht konfiguriert - Client-ID eintragen"},
        {"code": 202, "icon": "inactive", "caption": "Anmeldung erforderlich - Schritt 1 klicken"},
        {"code": 203, "icon": "inactive", "caption": "Warte auf Browser-Anmeldung - Schritt 2 nach Code-Eingabe klicken"}
    ]
}
