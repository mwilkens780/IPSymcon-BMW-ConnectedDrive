{
    "elements": [
        {
            "type": "ValidationTextBox",
            "name": "client_id",
            "caption": "BMW CarData Client-ID (UUID)",
            "validate": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        {
            "type": "Label",
            "caption": "Client-ID bekommst du unter: bmw-cardata.bmwgroup.com/customer/public (mit BMW-Account einloggen -> Client erstellen)"
        },
        {
            "type": "NumberSpinner",
            "name": "update_interval",
            "caption": "Aktualisierungsintervall (Sekunden)",
            "minimum": 300,
            "suffix": "s"
        },
        {
            "type": "Label",
            "caption": "Datenschutz/Fahrzeugzuweisung: bmw-cardata.bmwgroup.com -> MyBMW -> Fahrzeug -> CarData (oder Direktlink in BMW-Account unter Datenschutzeinstellungen)"
        }
    ],
    "actions": [
        {
            "type": "Label",
            "caption": "── Erstanmeldung (einmalig, danach laeuft Token-Refresh automatisch) ──"
        },
        {
            "type": "Label",
            "caption": "Schritt 1: Code generieren. Danach dieses Fenster schliessen und wieder oeffnen - Code und URL erscheinen dann oben."
        },
        {
            "type": "Button",
            "caption": "1. Anmeldung starten",
            "onClick": "BMWCD_StartDeviceAuth($id);"
        },
        {
            "type": "Label",
            "caption": "Schritt 2: Browser oeffnen (URL siehe oben), Code eingeben, mit BMW-Account bestaetigen, dann hier klicken:"
        },
        {
            "type": "Button",
            "caption": "2. Anmeldung pruefen (nach Browser-Bestaetigung)",
            "onClick": "BMWCD_CheckDeviceAuth($id);"
        },
        {
            "type": "Label",
            "caption": "── Manuell ──────────────────────────────────────────────────────────"
        },
        {
            "type": "Button",
            "caption": "Fahrzeugdaten jetzt abrufen",
            "onClick": "BMWCD_FetchVehicleData($id);"
        },
        {
            "type": "Button",
            "caption": "Auth zuruecksetzen (erzwingt erneuten Device-Code-Login)",
            "onClick": "BMWCD_ResetAuth($id);"
        }
    ],
    "status": [
        {
            "code": 101,
            "icon": "inactive",
            "caption": "Instanz wird erstellt"
        },
        {
            "code": 102,
            "icon": "active",
            "caption": "Verbunden"
        },
        {
            "code": 200,
            "icon": "error",
            "caption": "Fehler - Details im IPS-Log"
        },
        {
            "code": 201,
            "icon": "inactive",
            "caption": "Nicht konfiguriert - Client-ID eintragen"
        },
        {
            "code": 202,
            "icon": "inactive",
            "caption": "Anmeldung erforderlich - Schritt 1 klicken"
        },
        {
            "code": 203,
            "icon": "inactive",
            "caption": "Warte auf Browser-Anmeldung - Schritt 2 nach Code-Eingabe klicken"
        }
    ]
}
